# syntax=docker/dockerfile:1

# ---- Build stage ----
FROM docker.io/golang:1.26.7 AS build

WORKDIR /build

# Cache module downloads
COPY go.mod go.sum ./
RUN go mod download

# Build the binary
COPY main.go ./
RUN CGO_ENABLED=0 go build -ldflags="-s -w" -o /out/git-oipfs .

# ---- Runtime stage ----
FROM gcr.io/distroless/static-debian12:nonroot

# The app uses go-git to open and pull its own repository at "../".
# This directory (relative to the working dir) must be mounted from the host.
WORKDIR /app

COPY --from=build /out/git-oipfs /app/git-oipfs

# Repository path to watch (mounted from the host)
ENV OIPFS_REPOSITORY_PATH=/repo

ENTRYPOINT ["/app/git-oipfs"]
