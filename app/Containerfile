# syntax=docker/dockerfile:1

# ---- Build stage ----
FROM docker.io/rust:1.86 AS build

WORKDIR /build

# libgit2 requires openssl and cmake
RUN apt-get update && apt-get install -y --no-install-recommends cmake && rm -rf /var/lib/apt/lists/*

# Cache dependency downloads
COPY Cargo.toml Cargo.lock ./
RUN mkdir src && echo 'fn main() {}' > src/main.rs && cargo fetch

# Build the binary
COPY src ./src
RUN cargo build --release && cp target/release/git-oipfs /out/git-oipfs

# ---- Runtime stage ----
FROM gcr.io/distroless/static-debian12:nonroot

WORKDIR /app

COPY --from=build /out/git-oipfs /app/git-oipfs

# Repository path to watch (mounted from the host)
ENV OIPFS_REPOSITORY_PATH=/repo

ENTRYPOINT ["/app/git-oipfs"]
